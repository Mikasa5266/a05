VITE_BUILD_TARGET=web
VITE_ROUTER_MODE=history
VITE_API_BASE_URL=/api/v1
# Desktop build should use an absolute API URL, for example:
# VITE_API_BASE_URL=https://aiinterview2244.xyz/api/v1
# Backward-compatible alias. Prefer VITE_API_BASE_URL.
VITE_API_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8082
VITE_DEV_HTTPS=true
VITE_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
VITE_WEBRTC_TURN_URLS=
VITE_WEBRTC_TURN_USERNAME=
VITE_WEBRTC_TURN_CREDENTIAL=
