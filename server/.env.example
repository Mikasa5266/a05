# AI 模拟面试与技能提升系统 - 后端环境变量模板
#
# 说明：
# 1) 本文件用于集中管理配置，建议在本地复制为 server/.env 并填入真实值。
# 2) 下面字段是根据 server/config/config.go 的配置结构整理出的完整映射。
# 3) 当前项目默认从 config.yaml 读取配置，且已支持 ${ENV} / ${ENV:-default} 占位符。

# ==============================
# 服务基础配置（Config.Server）
# ==============================
# 服务监听地址，开发环境可用 0.0.0.0，生产环境建议绑定内网地址
SERVER_HOST=0.0.0.0
# 服务监听端口
SERVER_PORT=8082

# ==============================
# 数据库配置（Config.Database）
# ==============================
# 数据库主机地址
DB_HOST=127.0.0.1
# 数据库端口（MySQL 常用 3306）
DB_PORT=3306
# 数据库用户名
DB_USERNAME=root
# 数据库密码（请务必替换）
DB_PASSWORD=change_me
# 数据库名
DB_DATABASE=ai_mock_interview
# SSL 模式（MySQL 常见可填 disable）
DB_SSLMODE=disable

# ==============================
# JWT 配置（Config.JWT）
# ==============================
# JWT 签名密钥（生产环境必须使用高强度随机值）
JWT_SECRET=please_change_me_to_a_long_random_secret
# JWT 过期时间（通常按小时配置，具体以业务实现为准）
JWT_EXPIRE_TIME=24

# ==============================
# LLM 配置（Config.LLM）
# ==============================
# 大模型提供商标识（如 openai_compatible）
LLM_PROVIDER=openai_compatible
# 大模型 API Key
LLM_API_KEY=
# 大模型基础地址（OpenAI 兼容网关可填到 /v1）
LLM_BASE_URL=https://api.openai.com/v1
# 默认模型名称
LLM_MODEL=deepseek-chat

# 任务级模型覆盖（对应 LLM.Models map，可按需留空）
LLM_MODEL_CHAT=deepseek-chat
LLM_MODEL_EVALUATION=deepseek-chat
LLM_MODEL_REPORT=deepseek-chat
LLM_MODEL_RESUME=deepseek-chat
LLM_MODEL_RESUME_AUTHENTICITY=deepseek-chat
LLM_MODEL_RESUME_OPTIMIZATION=deepseek-chat
LLM_MODEL_RESUME_TEMPLATE=deepseek-chat
LLM_MODEL_SHADOW_HINT=deepseek-chat
LLM_MODEL_EMBEDDING=text-embedding-3-small

# ==============================
# ASR 配置（Config.ASR）
# ==============================
# 语音识别提供商
ASR_PROVIDER=openai_compatible
# 语音识别 API Key
ASR_API_KEY=
# 语音识别基础地址
ASR_BASE_URL=https://api.openai.com/v1
# ASR 模型名称
ASR_MODEL=whisper-1
# 单段音频最大字节数（建议与网关限制保持一致）
ASR_MAX_AUDIO_BYTES=10485760
# 最小切片间隔（秒）
ASR_CHUNK_MIN_INTERVAL_SECONDS=6
# 单场面试最大 ASR 调用次数
ASR_MAX_CALLS_PER_INTERVIEW=50

# ==============================
# TTS 配置（Config.TTS）
# ==============================
# 语音合成提供商
TTS_PROVIDER=openai_compatible
# 语音合成 API Key
TTS_API_KEY=
# 语音合成基础地址
TTS_BASE_URL=https://api.openai.com/v1
# TTS 模型名称
TTS_MODEL=gpt-4o-mini-tts
# 发音人
TTS_VOICE=alloy
# 是否启用 TTS（true/false）
TTS_ENABLED=true
# 单次请求最大字符数
TTS_MAX_CHARS_PER_REQUEST=1200
# 单场面试最大字符数
TTS_MAX_CHARS_PER_INTERVIEW=20000

# ==============================
# Prompt 配置（Config.Prompt）
# ==============================
# 自定义提示词模板目录（留空使用内置模板）
PROMPT_TEMPLATES_DIR=

# ==============================
# OCR 配置（Config.OCR）
# ==============================
# tesseract 可执行文件路径（Windows 示例：C:/Program Files/Tesseract-OCR/tesseract.exe）
OCR_TESSERACT_PATH=tesseract
# pdftoppm 可执行文件路径（Windows 可来自 poppler）
OCR_PDFTOPPM_PATH=pdftoppm
# tessdata 目录路径（可留空使用默认）
OCR_TESSDATA_PATH=
