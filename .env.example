# Embedding (OpenAI-compatible)
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT=20s
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_INITIAL_BACKOFF=400ms
EMBEDDING_RETRY_MAX_BACKOFF=4s

# Qdrant Vector DB
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_knowledge
QDRANT_DISTANCE=Cosine
QDRANT_VECTOR_SIZE=1536
QDRANT_TIMEOUT=8s
QDRANT_MAX_RETRIES=3
QDRANT_RETRY_INITIAL_BACKOFF=200ms
QDRANT_RETRY_MAX_BACKOFF=2s

ASR_PROVIDER=openai
ASR_API_KEY=
ASR_BASE_URL=https://api.zhizengzeng.com/v1
ASR_MODEL=gpt-4o-transcribe

